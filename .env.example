APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Inertia SSR (requires `npm run build:ssr` + `php artisan inertia:start-ssr` running).
# Falls back to client-side rendering automatically if the SSR server is down.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# GeoIP country override for local development/testing.
# Simulates a visitor from a specific country (bypasses private-IP skip).
# Examples: GEOIP_TEST_COUNTRY=PL  GEOIP_TEST_COUNTRY=DE  GEOIP_TEST_COUNTRY=GB
# Leave empty or remove in production.
# GEOIP_TEST_COUNTRY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production HMRC readiness requires ENCRYPT=true and SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAIL_ADMIN_ADDRESS=admin@website-expert.co.uk

STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# SaaS subscription webhook (osobny endpoint)
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_
# Stripe Price IDs (skopiuj z Stripe Dashboard → Products)
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_AGENCY_MONTHLY=price_

# TinyMCE
TINYMCE_API_KEY=your-tinymce-api-key-here

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# OAuth — Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# OpenAI (LP AI Generator)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=30
# OPENAI_RETRY_TIMES=2
# OPENAI_RETRY_SLEEP_MS=750

# Google reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# Google Rank Checker (SEO tool) — SERP provider
# SERP_PROVIDER=manual is a free stub; switch to "dataforseo" once credentials are set below.
SERP_PROVIDER=manual
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_BASE_URL=https://api.dataforseo.com
# DATAFORSEO_TIMEOUT=20
# RANK_CHECK_CACHE_TTL_HOURS=8
# RANK_CHECK_TOP_RESULTS=100
# RANK_CHECK_DEFAULT_LOCATION="United Kingdom"

# Security — fail2ban webhook (POST /api/security/webhook, header X-Security-Secret)
# Generate a long random value and configure the matching fail2ban action on the server to send it.
SECURITY_WEBHOOK_SECRET=

# AbuseIPDB (used by the "Report to AbuseIPDB" action on /admin/security-events)
ABUSEIPDB_API_KEY=

# HMRC Making Tax Digital for VAT
# Never commit real client secrets or OAuth tokens.
HMRC_ENVIRONMENT=sandbox
HMRC_SANDBOX_CLIENT_ID=
HMRC_SANDBOX_CLIENT_SECRET=
HMRC_SANDBOX_REDIRECT_URI="${APP_URL}/admin/hmrc/oauth/callback"
# Optional sandbox-only fixed scenario for the obligations endpoint, for example QUARTERLY_NONE_MET.
HMRC_SANDBOX_OBLIGATIONS_SCENARIO=
HMRC_SANDBOX_RETURN_SCENARIO=
HMRC_SANDBOX_LIABILITIES_SCENARIO=
HMRC_SANDBOX_PAYMENTS_SCENARIO=
# Optional submit scenario: INVALID_VRN, INVALID_PERIODKEY, INVALID_PAYLOAD,
# DUPLICATE_SUBMISSION, TAX_PERIOD_NOT_ENDED or INSOLVENT_TRADER. Leave blank for success.
HMRC_SANDBOX_SUBMISSION_SCENARIO=
# Production remains locked unless both the HMRC approval and an explicit deployment decision exist.
HMRC_PRODUCTION_ACCESS_ENABLED=false
HMRC_PRODUCTION_SUBMISSION_ENABLED=false
HMRC_PRODUCTION_APPROVAL_REFERENCE=
HMRC_PRODUCTION_FPH_VALIDATION_REFERENCE=
HMRC_PRODUCTION_SECURITY_REVIEW_REFERENCE=
HMRC_PRODUCTION_OWNER_APPROVAL_REFERENCE=
HMRC_PRODUCTION_CLIENT_ID=
HMRC_PRODUCTION_CLIENT_SECRET=
HMRC_PRODUCTION_REDIRECT_URI="${APP_URL}/admin/hmrc/oauth/callback"
# HMRC_TIMEOUT=20
# HMRC_OAUTH_STATE_TTL=600
# HMRC_FPH_BROWSER_CONTEXT_TTL=1800
# Set only when a trusted proxy strips and overwrites these headers.
HMRC_CLIENT_PUBLIC_IP_HEADER=
HMRC_CLIENT_PUBLIC_PORT_HEADER=
HMRC_PRODUCT_NAME="Website Expert NI"
HMRC_PRODUCT_ID=website-expert-ni
HMRC_PRODUCT_VERSION=
HMRC_VENDOR_PUBLIC_IP=
# Public TLS termination IPs in client-to-HMRC order; defaults to HMRC_VENDOR_PUBLIC_IP.
HMRC_VENDOR_FORWARDING_CHAIN=
# Set only when the installation has a genuine software licence identifier.
HMRC_VENDOR_LICENSE_ID=
# Required if HMRC has approved any entry in HMRC_FPH_ALLOWED_MISSING_HEADERS.
HMRC_FPH_EXCEPTION_REFERENCE=
# Configure only after HMRC accepts an exceptional missing-header case.
HMRC_FPH_ALLOWED_MISSING_HEADERS=

# Configure only after HMRC grants production credentials.
HMRC_PRODUCTION_CLIENT_ID=
HMRC_PRODUCTION_CLIENT_SECRET=
HMRC_PRODUCTION_REDIRECT_URI="${APP_URL}/admin/hmrc/oauth/callback"

